FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=10

WORKDIR /app

ARG PYPI_INDEX_URL=https://pypi.org/simple

COPY pyproject.toml ./
RUN python -m pip install --index-url ${PYPI_INDEX_URL} hatchling \
    && python -c "import subprocess,sys,tomllib; p=tomllib.load(open('pyproject.toml','rb')); subprocess.check_call([sys.executable,'-m','pip','install','--index-url','${PYPI_INDEX_URL}',*p['project']['dependencies']])"

COPY README.md prd.md ./
COPY app ./app
RUN python -m pip install --no-deps --no-build-isolation .

EXPOSE 8020
CMD ["uvicorn", "app.python_runner.main:app", "--host", "0.0.0.0", "--port", "8020"]

