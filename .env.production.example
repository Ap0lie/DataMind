# Copy this file to .env.production and replace every change-me value.
# Passwords are embedded in service URLs, so use URL-safe random values such as:
# openssl rand -hex 32

COMPOSE_PROJECT_NAME=datamind
DATAMIND_IMAGE_TAG=latest
DATAMIND_PYPI_INDEX_URL=https://pypi.org/simple

# Public HTTPS endpoint. Point this DNS name at the server before starting Caddy.
DATAMIND_DOMAIN=datamind.example.com
DATAMIND_PUBLIC_ORIGIN=https://datamind.example.com
DATAMIND_HTTP_PORT=80
DATAMIND_HTTPS_PORT=443

# Keep the direct API diagnostic port bound to localhost.
DATAMIND_API_BIND_ADDRESS=127.0.0.1
DATAMIND_API_PORT=8010
DATAMIND_WORKER_CONCURRENCY=2

DATAMIND_POSTGRES_PASSWORD=change-me-url-safe-postgres-password
DATAMIND_REDIS_PASSWORD=change-me-url-safe-redis-password
DATAMIND_PYTHON_RUNNER_SHARED_SECRET=change-me-long-runner-secret

DATAMIND_DEEPSEEK_API_KEY=
DATAMIND_KIMI_API_KEY=
DATAMIND_DEEPSEEK_BASE_URL=https://api.deepseek.com
DATAMIND_KIMI_BASE_URL=https://api.moonshot.cn/v1
DATAMIND_DEEPSEEK_MODEL=deepseek-chat
DATAMIND_KIMI_MODEL=kimi-k2.6

# Unified prompt budget. Production sends only the bounded prompt.
DATAMIND_LLM_PROMPT_MAX_CHARS=120000
DATAMIND_CONTEXT_BUDGET_ENABLED=true
DATAMIND_CONTEXT_BUDGET_MODE=enforce
DATAMIND_LLM_CONTEXT_WINDOW_TOKENS=65536
DATAMIND_CONTEXT_SAFETY_RATIO=0.15
DATAMIND_TOOL_DISTILLATION_ENABLED=true
DATAMIND_TOOL_DISTILLATION_STRATEGY=auto
DATAMIND_TOOL_DISTILLATION_PROVIDER=deepseek
DATAMIND_TOOL_DISTILLATION_MODEL=deepseek-chat
DATAMIND_TOOL_DISTILLATION_MIN_SOURCE_CHARS=48000
DATAMIND_TOOL_DISTILLATION_CHUNK_CHARS=8000
DATAMIND_TOOL_DISTILLATION_MAX_CHUNKS=24
DATAMIND_TOOL_DISTILLATION_BATCH_SIZE=4
DATAMIND_TOOL_DISTILLATION_MAX_ATTEMPTS=2
DATAMIND_TOOL_DISTILLATION_TIMEOUT_SECONDS=20
DATAMIND_TOOL_CONTEXT_TARGET_CHARS=12000
DATAMIND_TOOL_CONTEXT_MAX_CHARS=24000
DATAMIND_TOOL_CONTINUATION_ENABLED=true
DATAMIND_TOOL_CONTINUATION_MAX_CALLS=2
DATAMIND_TOOL_CONTINUATION_MAX_CHARS=12000
DATAMIND_TOOL_CONTINUATION_SCAN_MAX_BYTES=33554432
DATAMIND_TOOL_ARTIFACT_PATH=/data/tool-artifacts
DATAMIND_TOOL_ARTIFACT_MAX_BYTES=209715200
DATAMIND_TOOL_ARTIFACT_TTL_DAYS=30
DATAMIND_TOOL_ARTIFACT_FAILED_TTL_DAYS=7

# Guarded intent compilation. Keep shadow mode until cross-domain calibration passes.
DATAMIND_INTENT_COMPILER_ENABLED=true
DATAMIND_INTENT_COMPILER_MODE=shadow
DATAMIND_INTENT_COMPILER_PROVIDER=deepseek
DATAMIND_INTENT_COMPILER_MAX_REPAIRS=2
DATAMIND_INTENT_COMPILER_TIMEOUT_SECONDS=20
DATAMIND_CONTRACT_GUARD_ENABLED=true

DATAMIND_ASSISTANT_ENABLED=true
DATAMIND_ASSISTANT_MEMORY_ENABLED=true
DATAMIND_ASSISTANT_MEMORY_SUMMARY_MESSAGES=12
DATAMIND_ASSISTANT_MEMORY_SUMMARY_CHARS=24000
DATAMIND_ASSISTANT_MEMORY_SUMMARY_MAX_CHARS=3000
DATAMIND_ASSISTANT_MEMORY_RETRIEVAL_LIMIT=8
DATAMIND_ASSISTANT_MEMORY_CONTEXT_CHARS=4000
DATAMIND_ASSISTANT_MEMORY_TTL_DAYS=180
DATAMIND_ASSISTANT_MEMORY_RECYCLE_DAYS=30
DATAMIND_ASSISTANT_MEMORY_TIMEOUT_SECONDS=10
DATAMIND_ASSISTANT_MEMORY_RELEVANCE_THRESHOLD=0.32
DATAMIND_ASSISTANT_MEMORY_PREFILTER_LIMIT=100
DATAMIND_ASSISTANT_MEMORY_MMR_LAMBDA=0.75
DATAMIND_ASSISTANT_MEMORY_EXPERIENCE_ENABLED=true
DATAMIND_SEMANTIC_EMBEDDING_ENABLED=true
DATAMIND_SEMANTIC_EMBEDDING_REQUIRED=true
DATAMIND_AGENT_LOOP_DEFAULT_MODE=loop
DATAMIND_ANALYSIS_FAST_PATH_ENABLED=true
DATAMIND_ANALYSIS_FAST_PATH_MAX_ROWS=1000
DATAMIND_OTEL_EXPORTER_OTLP_ENDPOINT=
