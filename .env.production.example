# Copy this file to .env.production and replace every change-me value.
# Passwords are embedded in service URLs, so use URL-safe random values such as:
# openssl rand -hex 32

COMPOSE_PROJECT_NAME=datamind
DATAMIND_IMAGE_TAG=latest
DATAMIND_PYPI_INDEX_URL=https://pypi.org/simple

# Public HTTPS endpoint. Point this DNS name at the server before starting Caddy.
DATAMIND_DOMAIN=datamind.example.com
DATAMIND_PUBLIC_ORIGIN=https://datamind.example.com
DATAMIND_HTTP_PORT=80
DATAMIND_HTTPS_PORT=443

# Keep the direct API diagnostic port bound to localhost.
DATAMIND_API_BIND_ADDRESS=127.0.0.1
DATAMIND_API_PORT=8010
DATAMIND_WORKER_CONCURRENCY=2

DATAMIND_POSTGRES_PASSWORD=change-me-url-safe-postgres-password
DATAMIND_REDIS_PASSWORD=change-me-url-safe-redis-password
DATAMIND_PYTHON_RUNNER_SHARED_SECRET=change-me-long-runner-secret

DATAMIND_DEEPSEEK_API_KEY=
DATAMIND_KIMI_API_KEY=
DATAMIND_DEEPSEEK_BASE_URL=https://api.deepseek.com
DATAMIND_KIMI_BASE_URL=https://api.moonshot.cn/v1
DATAMIND_DEEPSEEK_MODEL=deepseek-chat
DATAMIND_KIMI_MODEL=kimi-k2.6

DATAMIND_ASSISTANT_ENABLED=true
DATAMIND_SEMANTIC_EMBEDDING_ENABLED=true
DATAMIND_SEMANTIC_EMBEDDING_REQUIRED=true
DATAMIND_AGENT_LOOP_DEFAULT_MODE=loop
DATAMIND_OTEL_EXPORTER_OTLP_ENDPOINT=
