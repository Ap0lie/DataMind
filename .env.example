DATAMIND_APP_NAME=DataMind API
DATAMIND_APP_VERSION=0.1.0
DATAMIND_API_PREFIX=/api/v1
DATAMIND_DEBUG=false
DATAMIND_DATASET_STORE_PATH=data/datasets
DATAMIND_DATABASE_URL=
DATAMIND_REDIS_URL=redis://127.0.0.1:6379/0
DATAMIND_EXECUTION_BACKEND=local
DATAMIND_CHECKPOINT_BACKEND=sqlite
DATAMIND_AUTH_MODE=legacy
DATAMIND_SESSION_COOKIE_SECURE=false
DATAMIND_SESSION_TTL_SECONDS=43200
DATAMIND_SESSION_ABSOLUTE_TTL_SECONDS=604800
DATAMIND_ALLOW_MCP_INVOKE=false
DATAMIND_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DATAMIND_RATE_LIMITS_ENABLED=false
DATAMIND_PYTHON_RUNNER_URL=
DATAMIND_PYTHON_RUNNER_SHARED_SECRET=
DATAMIND_PYTHON_SANDBOX_IMAGE=datamind-python-sandbox:latest
DATAMIND_OTEL_EXPORTER_OTLP_ENDPOINT=

# LLM calls must go through Model Router MCP.
# Set DATAMIND_LLM_PROVIDER=mock to globally override all agent-level providers.
DATAMIND_LLM_PROVIDER=
DATAMIND_DEFAULT_LLM_PROVIDER=deepseek
DATAMIND_PLANNER_LLM_PROVIDER=deepseek
DATAMIND_SQL_LLM_PROVIDER=deepseek
DATAMIND_PYTHON_LLM_PROVIDER=deepseek
DATAMIND_REFLECTION_LLM_PROVIDER=deepseek
DATAMIND_REPORT_LLM_PROVIDER=kimi
DATAMIND_REVIEW_LLM_PROVIDER=kimi
DATAMIND_MULTIMODAL_LLM_PROVIDER=kimi
DATAMIND_LLM_MODEL=
DATAMIND_DEEPSEEK_MODEL=deepseek-chat
DATAMIND_KIMI_MODEL=moonshot-v1-32k
DATAMIND_LLM_BASE_URL=
DATAMIND_DEEPSEEK_BASE_URL=
DATAMIND_KIMI_BASE_URL=https://api.moonshot.cn/v1
DATAMIND_LLM_API_KEY=
DATAMIND_DEEPSEEK_API_KEY=
DATAMIND_KIMI_API_KEY=
DATAMIND_BENCHMARK_PROVIDER=
DATAMIND_BENCHMARK_MODEL=
BENCHMARK_DATA_ROOT=
DATAMIND_LLM_TIMEOUT_SECONDS=30
DATAMIND_LLM_MAX_TOKENS=2048

# Evidence-backed Kimi assistant. This model is independent from report routing.
DATAMIND_ASSISTANT_ENABLED=true
DATAMIND_ASSISTANT_LLM_PROVIDER=kimi
DATAMIND_ASSISTANT_LLM_MODEL=kimi-k2.6
DATAMIND_ASSISTANT_MAX_TOOL_CALLS=8
DATAMIND_ASSISTANT_MAX_CONTEXT_CHARS=60000
DATAMIND_ASSISTANT_TIMEOUT_SECONDS=300
DATAMIND_ASSISTANT_LLM_TIMEOUT_SECONDS=120
DATAMIND_ASSISTANT_IMAGE_MAX_BYTES=5242880
DATAMIND_ASSISTANT_DATA_FILE_MAX_BYTES=209715200
DATAMIND_ASSISTANT_DATA_FILE_MAX_COUNT=20
DATAMIND_ASSISTANT_DATA_BATCH_MAX_BYTES=1073741824
DATAMIND_ASSISTANT_RECYCLE_RETENTION_DAYS=30
DATAMIND_ASSISTANT_RATE_LIMIT=30

# Bounded autonomous analysis loop. Loop is the default; legacy remains an explicit compatibility mode.
DATAMIND_AGENT_LOOP_ENABLED=true
DATAMIND_AGENT_LOOP_DEFAULT_MODE=loop
DATAMIND_AGENT_LOOP_ALLOW_REQUEST_OVERRIDE=true
DATAMIND_AGENT_LOOP_PROVIDER=deepseek
DATAMIND_AGENT_LOOP_MODEL=
DATAMIND_AGENT_LOOP_MAX_TOOL_CALLS=12
DATAMIND_AGENT_LOOP_MAX_DECISIONS=16
DATAMIND_AGENT_LOOP_MAX_TOOL_ATTEMPTS=3
DATAMIND_AGENT_LOOP_TIMEOUT_SECONDS=300
DATAMIND_AGENT_LOOP_MAX_TOKENS=50000

# Autonomous cleaning loop (local default enabled; production may phase it in).
DATAMIND_CLEANING_LOOP_ENABLED=true
DATAMIND_CLEANING_LOOP_MAX_DECISIONS=8
DATAMIND_CLEANING_LOOP_MAX_TOOL_CALLS=5
DATAMIND_CLEANING_LOOP_MAX_STRATEGY_ATTEMPTS=2
DATAMIND_CLEANING_LOOP_TIMEOUT_SECONDS=180
DATAMIND_CLEANING_LOOP_MAX_TOKENS=12000

# Autonomous report loop, active only for analysis agent_mode=loop.
DATAMIND_REPORT_LOOP_ENABLED=true
DATAMIND_REPORT_LOOP_MAX_DECISIONS=6
DATAMIND_REPORT_LOOP_MAX_REVISIONS=2
DATAMIND_REPORT_LOOP_TIMEOUT_SECONDS=60
DATAMIND_REPORT_LOOP_MAX_TOKENS=8000
